FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Core profile intentionally omits Node.js/WhatsApp and LiteLLM. It supports
# headless deployments through the built-in HTTPX OpenAI-compatible client.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md /app/
COPY lumen /app/lumen

RUN pip install --no-cache-dir .

EXPOSE 3000

CMD ["lumen", "server", "--host", "0.0.0.0", "--port", "3000"]
